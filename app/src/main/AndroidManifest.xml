<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fully offline: no permissions at all. -->

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoonPhases"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.MoonPhases">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The default Stage holds the whole lesson: Progressive style (2), launched at immersion 100
                 (= a dark classroom); the user may turn it down to 50 to see the room (safety valve).
                 Style values: 0 Automatic, 1 Mixed, 2 Progressive, 3 Full (SDK 6.1 declare-a-stage). -->
            <meta-data android:name="pico.spatial.stage.id" android:value="MoonStage" />
            <meta-data android:name="pico.spatial.stage.style" android:value="2" />
            <meta-data android:name="pico.spatial.stage.immersion" android:value="100" />
            <meta-data android:name="pico.spatial.stage.immersion_min" android:value="50" />
            <meta-data android:name="pico.spatial.stage.immersion_max" android:value="100" />
        </activity>

        <!-- QA hook: switches the app to any named state over adb (see AGENTS.md). Only acts in debuggable builds. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.embodit.moonphases.DEBUG" />
            </intent-filter>
        </receiver>

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
